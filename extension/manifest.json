{
  "manifest_version": 3,
  "name": "Parallel Image Orchestrator",
  "version": "0.2.7",
  "key": "",
  "permissions": [
    "storage",
    "debugger",
    "downloads",
    "nativeMessaging",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_page": "options.html"
}
